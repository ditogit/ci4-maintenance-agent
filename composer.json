{
    "name": "ditogit/ci4-agent",
    "description": "Lightweight, secure, versioned REST API agent for CodeIgniter 4 — standardized monitoring & maintenance for CI4 Project Hub",
    "type": "library",
    "keywords": ["codeigniter4", "maintenance", "monitoring", "agent", "ci4"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "codeigniter4/framework": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "mikey179/vfsstream": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "MaintenanceAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "codeigniter4": {
            "registrar": "MaintenanceAgent\\Config\\Registrar"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
